BOT_TOKEN=replace_with_botfather_token
OWNER_ID=123456789
ADMIN_IDS=

# Local checkout site. Production validation requires HTTPS.
SITE_HOST=127.0.0.1
SITE_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Set to the HTTPS Mini App page URL after the site has a public domain.
MINI_APP_URL=
# Set only when hosting the Mini App frontend on a different origin (for example GitHub Pages).
MINI_APP_ORIGIN=

# This project intentionally uses a new DB file; keep the legacy orders.sqlite3 untouched.
APP_DATABASE_PATH=app-orders.sqlite3
CONFIG_PATH=config.yml
BACKUP_DIR=backups

# Dedicated receiving wallets. A receiving wallet needs no seed phrase on this server.
USDT_TRC20_ADDRESS=
TON_ADDRESS=
TRONGRID_API_KEY=
TONCENTER_API_KEY=
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Safe default: simulation only. Production remains fail-closed until Fragment's seedless API contract is verified.
DRY_RUN=true
FULFILLMENT_MODE=mock
ALLOW_THIRD_PARTY_SIGNING=false

ORDER_TTL_SECONDS=1800
PAYMENT_GRACE_SECONDS=600
POLL_SECONDS=15
MAX_ACTIVE_ORDERS_PER_USER=3
MAX_TRON_OFFSET_USDT=0.05
USDT_AMOUNT_TOLERANCE=0.000001
TON_AMOUNT_TOLERANCE=0.000000001
RATES_MAX_DEVIATION_PERCENT=10
SUPPORT_USERNAME=
